# Local release-candidate recipe. PUBLICATION BLOCKED until a public immutable source URL is supplied.
# Generate PKGBUILD and .SRCINFO with scripts/prepare-native.py; no floating Git branch.
# Maintainer: zinverno <https://github.com/zinverno>
pkgname=yanjaro
pkgver=0.2.0rc4
pkgrel=1
pkgdesc='Unofficial Yandex Music client / Неофициальный клиент Яндекс Музыки'
url='https://github.com/zinverno/yanjaro'
arch=('any')
license=('GPL-3.0-or-later' 'LGPL-3.0-only')
depends=('python>=3.11' 'python<3.15' 'pyside6>=6.8' 'pyside6<7' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-utils' 'python-mpv>=1.0.8' 'mpv>=0.41' 'python-secretstorage>=3.5' 'python-jeepney>=0.9' 'python-requests' 'python-pysocks' 'python-typing_extensions>=4.4.0')
checkdepends=('desktop-file-utils')
_sdk='yandex_music-3.2.0-py3-none-any.whl'
source=("yanjaro-$pkgver.tar.gz" "$_sdk::https://files.pythonhosted.org/packages/67/76/fc7b9653df26f3f8255e033a302a478b4eb899beeddbd66ae48c005654bb/yandex_music-3.2.0-py3-none-any.whl")
noextract=("$_sdk")
sha256sums=('11dd959d197f44ed61581cf120646baf0c10bcd2eca025cf939e851e031e8377' 'b897889882707512ece92ca5663aba879dcaa26a88a6ba1c301dec6e2c5bdc3c')

prepare() {
    mkdir -p "$srcdir/sdk"
    bsdtar --no-same-owner -xf "$srcdir/$_sdk" -C "$srcdir/sdk"
}

check() {
    cd "$srcdir/yanjaro-$pkgver"
    PYTHONPATH="$srcdir/sdk" QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests -v
    /usr/lib/qt6/bin/qmllint yanjaro/*.qml
    for scale in 1 1.25 1.5; do
        PYTHONPATH="$srcdir/sdk" QT_QPA_PLATFORM=offscreen QT_SCALE_FACTOR="$scale" python tests/render_ui.py "$srcdir/ui-checks/$scale"
    done
    desktop-file-validate packaging/yanjaro.desktop
}

package() {
    cd "$srcdir/yanjaro-$pkgver"
    install -d "$pkgdir/usr/lib/yanjaro/yanjaro/icons"
    install -m644 yanjaro/*.py yanjaro/*.qml yanjaro/qmldir "$pkgdir/usr/lib/yanjaro/yanjaro/"
    install -m644 yanjaro/icons/* "$pkgdir/usr/lib/yanjaro/yanjaro/icons/"
    bsdtar --no-same-owner -xf "$srcdir/$_sdk" -C "$pkgdir/usr/lib/yanjaro"
    install -Dm755 packaging/yanjaro "$pkgdir/usr/bin/yanjaro"
    install -Dm644 packaging/yanjaro.desktop "$pkgdir/usr/share/applications/yanjaro.desktop"
    install -Dm644 yanjaro/icons/yanjaro.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/yanjaro.svg"
    install -Dm644 LICENSE-STATUS.md "$pkgdir/usr/share/licenses/yanjaro/LICENSE-STATUS.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/yanjaro/LICENSE"
    install -Dm644 "$srcdir/sdk/yandex_music-3.2.0.dist-info/licenses/LICENSE" "$pkgdir/usr/share/licenses/yanjaro/yandex-music-LICENSE"
    install -d "$pkgdir/usr/share/doc/yanjaro/docs/screenshots"
    install -m644 README.md VALIDATION.md LICENSE LICENSE-STATUS.md "$pkgdir/usr/share/doc/yanjaro/"
    install -m644 docs/*.md "$pkgdir/usr/share/doc/yanjaro/docs/"
    install -m644 docs/screenshots/*.png "$pkgdir/usr/share/doc/yanjaro/docs/screenshots/"
    install -d "$pkgdir/usr/share/doc/yanjaro/docs/screenshots/rc2"
    install -m644 docs/screenshots/rc2/*.png "$pkgdir/usr/share/doc/yanjaro/docs/screenshots/rc2/"
}
